{
  "name": "larena/telephony",
  "description": "Provider-neutral telephony contracts, adapter SDK and conformance kit for Larena.",
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rim Zabarov",
      "homepage": "https://github.com/zabarov",
      "role": "Author"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^13.0",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Larena\\Telephony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Larena\\Telephony\\Tests\\": "tests/",
      "Acme\\LarenaTelephonyDemo\\": "tests/Fixtures/IndependentAdapter/src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Larena\\Telephony\\Providers\\TelephonyServiceProvider"
      ]
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0"
  },
  "scripts": {
    "test": "@php -d zend.assertions=1 -d assert.exception=1 tests/run.php",
    "test:unit": "@test",
    "conformance": "@php scripts/run-conformance.php",
    "conformance:check": "@php scripts/run-conformance.php --check",
    "lint": "@php scripts/lint.php",
    "analyse": "@php scripts/analyse.php",
    "validate:larena": "@php scripts/validate-larena-package.php",
    "evidence:check": "@php scripts/check-evidence.php",
    "scope:check": "@php tools/larena-scope-check.php",
    "quality:gate": [
      "@validate:larena",
      "@lint",
      "@analyse",
      "@test",
      "@conformance:check",
      "@evidence:check",
      "@scope:check"
    ]
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.31"
    },
    "allow-plugins": {}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
